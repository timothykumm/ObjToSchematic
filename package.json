{
  "name": "objtoschematic",
  "private": true,
  "version": "0.0.0",
  "description": "A tool to convert 3D models into Minecraft formats such as .schematic, .litematic, .schem and .nbt",
  "main": "./dist/src/main.js",
  "engines": {
    "node": ">=16.8.0"
  },
  "scripts": {
    "lint": "eslint --fix src tools tests --ext .ts",
    "lint-src": "eslint --fix src --ext .ts",
    "test": "jest --config jestconfig.json",
    "start": "vite",
    "dist": "vite build",
    "atlas": "ts-node ./tools/build-atlas.ts",
    "headless": "ts-node ./tools/run-headless.ts",
    "build": "tsc",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasDower/ObjToSchematic.git"
  },
  "author": "Lucas Dower",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/LucasDower/ObjToSchematic/issues"
  },
  "homepage": "https://github.com/LucasDower/ObjToSchematic#readme",
  "devDependencies": {
    "@types/adm-zip": "^0.5.0",
    "@types/jest": "^27.4.1",
    "@types/jquery": "^3.5.6",
    "@types/merge-images": "^1.2.1",
    "@types/pngjs": "^6.0.1",
    "@types/prompt": "^1.1.2",
    "@types/sharp": "^0.31.0",
    "@types/varint": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^5.9.1",
    "@typescript-eslint/parser": "^5.9.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "browserify-zlib": "^0.2.0",
    "bvh-tree": "^1.0.1",
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "eslint": "^8.7.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-simple-import-sort": "^8.0.0",
    "ga-gtag": "^1.1.7",
    "hsv-rgb": "^1.0.0",
    "i18next": "^22.4.14",
    "jest": "^27.5.1",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0",
    "prismarine-nbt": "^2.2.1",
    "prompt": "^1.2.1",
    "ts-jest": "^27.1.3",
    "ts-node": "^10.1.0",
    "twgl.js": "^5.3.0",
    "typescript": "^4.3.5",
    "varint-array": "^0.0.0",
    "vite": "^5.4.19",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vite-plugin-static-copy": "^1.0.0",
    "vue-template-compiler": "^2.7.16"
  },
  "dependencies": {
    "@loaders.gl/core": "^3.3.1",
    "@loaders.gl/gltf": "^3.3.1",
    "@vue/shared": "^3.5.16",
    "split.js": "^1.6.5",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  }
